{{if .PageIsSignIn}}
<div class="ui container f451-signin-note" style="max-width:440px!important;margin-top:2rem;text-align:center;color:var(--color-text-light);font-size:0.95rem">
  <div style="display:inline-flex;align-items:center;gap:.6rem;color:var(--color-text)">
    <img src="{{AssetUrlPrefix}}/img/logo.svg" width="36" height="36" alt="">
    <span style="font-family:'Instrument Serif',Georgia,serif;font-size:1.6rem">f451</span>
  </div>
  <p style="margin:.6rem 0 0">This is the Git side of the f451 demo. Sign in with one of the demo accounts from the f451 sign-in page — you will be taken back to f451 afterwards.</p>
</div>
{{end}}
