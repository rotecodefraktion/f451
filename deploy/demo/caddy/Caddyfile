# TLS certificates come from Let's Encrypt automatically.
# Maintenance mode: demo.sh creates /srv/state/maintenance for the duration of
# a deploy (see `maintenance` there); while the file exists every request to
# the APP host gets the rebuilding page with 503. No reload needed — the matcher
# checks per request. Forgejo stays reachable: a deploy never restarts it, and
# the API's start-up discovers the OIDC issuer through this very proxy.
(maintenance) {
	@maintenance {
		file {
			root /srv/state
			try_files /maintenance
		}
	}
	handle @maintenance {
		root * /srv/maintenance
		header Cache-Control no-store
		header Retry-After 10
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}

{$F451_DEMO_HOST} {
	encode zstd gzip
	# Access log for the visitor statistics (GoAccess, `demo.sh stats`). IPs are
	# shortened (/24, /48) and cookies/credentials dropped before anything is
	# written; the files live in the caddy-logs volume, which no reset touches.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 20
		}
		format filter {
			wrap json
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
	import maintenance
	# Visitor statistics, password-protected (credentials in demo.env).
	redir /stats /stats/
	handle_path /stats/* {
		basic_auth {
			{$F451_STATS_USER} {$F451_STATS_HASH}
		}
		root * /srv/stats
		file_server
	}
	# Instance theme (colours + typefaces), loaded via F451_CUSTOM_STYLESHEET.
	handle_path /custom/* {
		root * /srv/theme
		file_server
	}
	reverse_proxy web:3000 {
		# A deploy replaces the app containers; hold requests until the new
		# one answers instead of failing with 502. Retries happen only while
		# dialing, so unsafe requests are never sent twice.
		lb_try_duration 60s
		lb_try_interval 250ms
	}
}

{$F451_DEMO_GIT_HOST} {
	encode zstd gzip
	# Legal links in Forgejo's footer (forgejo/templates/custom/footer.tmpl).
	redir /imprint {$F451_IMPRINT_URL}
	redir /privacy {$F451_PRIVACY_URL}
	reverse_proxy forgejo:3000 {
		lb_try_duration 60s
		lb_try_interval 250ms
	}
}
