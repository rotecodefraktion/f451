# Kopieren nach .env und Werte setzen
#
# Vollständige, gegen den Code verifizierte Env-Referenz + Betriebsdoku
# (Architektur, Restore-Prozedur, Störungs-Drehbuch, Monitoring):
# ../BETRIEB.md
POSTGRES_PASSWORD=wiki-dev

# Self-hosted draw.io für den eingebetteten Diagramm-Editor (Spec §6/§7).
# Wird zur BUILD-Zeit ins Web-Bundle eingebrannt (NEXT_PUBLIC_*, Muster API_URL) —
# MUSS vom Browser aus erreichbar sein (anders als API_URL, das den internen
# Docker-Netzwerknamen der api nutzt), deshalb hier der host-gemappte Port statt
# des Compose-Servicenamens `drawio`.
NEXT_PUBLIC_DRAWIO_URL=http://localhost:8081

# --- Indexer/Space-Konfiguration (Phase 1c) --------------------------------
# Alle Werte unten sind optional: fehlt F451_SPACES, startet die API im
# Minimalmodus (nur /healthz, /readyz). Details + vollständige Env-Referenz:
# apps/api/README.md.

# JSON-Array konfigurierter Spaces (ein Eintrag pro Wiki-Repo).
F451_SPACES=[{"id":"betrieb","name":"Betrieb","provider":"forgejo","owner":"dev-docs","repo":"betrieb","defaultLang":"de"}]

# Nur nötig, wenn mindestens ein Space provider="forgejo" verwendet.
F451_FORGEJO_URL=https://git.example.com
F451_FORGEJO_TOKEN=change-me-forgejo-service-account-token

# Nur nötig, wenn mindestens ein Space provider="github" verwendet.
F451_GITHUB_TOKEN=change-me-github-service-account-token

# Webhook-Secrets (HMAC) — beim Anlegen des Webhooks im jeweiligen Provider
# identisch eintragen (siehe apps/api/README.md, Abschnitt "Webhook-Einrichtung").
F451_WEBHOOK_SECRET_FORGEJO=change-me-forgejo-webhook-secret
F451_WEBHOOK_SECRET_GITHUB=change-me-github-webhook-secret

# Bearer-Token für POST /admin/reindex. Ohne gesetztes Token lehnt der
# Endpunkt jede Anfrage ab (Fail-Closed). Zusätzlich verlangt /admin/* bei
# aktiver Auth (s. u.) auch eine gültige Session.
F451_ADMIN_TOKEN=change-me-admin-token

# Optionales globales Vorlagen-Repo (Phase 3c Task 2) — JSON-Objekt
# {"provider","owner","repo"}, Muster wie F451_SPACES-Einträge. Ohne gesetzte
# Variable liefert GET /api/spaces/:space/templates nur Space-eigene Vorlagen
# (_templates/*.md).
#F451_GLOBAL_TEMPLATES={"provider":"forgejo","owner":"dev-docs","repo":"templates"}

# --- Auth (Phase 1d) --------------------------------------------------------
# Optional: fehlt F451_OIDC_ISSUER, bleibt die API im 1c-Verhalten (alles
# offen, kein Login). Details + Entra-/Forgejo-Einrichtung: apps/api/README.md,
# Abschnitt "Auth".

# Entra ID (OIDC) — App-Registrierung mit Redirect-URI
# https://<api-host>/auth/callback.
F451_OIDC_ISSUER=https://login.microsoftonline.com/change-me-tenant-id/v2.0
F451_OIDC_CLIENT_ID=change-me-oidc-client-id
F451_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
F451_OIDC_REDIRECT_URL=https://change-me-api-host/auth/callback
# Name on the sign-in button ("Sign in with …"), e.g. Microsoft Entra, Forgejo,
# Keycloak. Unset → a plain "Sign in".
#F451_OIDC_PROVIDER_NAME=Microsoft Entra

# Schlüssel zur Verschlüsselung der Provider-Tokens (AES-256-GCM), 32 Byte
# base64 — erzeugen per: openssl rand -base64 32
F451_TOKEN_KEY=change-me-32-byte-base64-token-key

# Nur für lokale HTTP-Entwicklung setzen (deaktiviert `secure` auf Cookies) —
# in Produktion NICHT setzen.
#F451_INSECURE_COOKIES=1

# Prefix for the auth cookie names (default f451 → f451_session, …). Browsers
# share cookies across ports, so give each instance on the same host its own.
# Letters, digits, _ and - only.
#F451_COOKIE_PREFIX=f451

# Host ports (defaults 8080 / 8081) — change for a second stack on this host.
#F451_WEB_PORT=8080
#F451_DRAWIO_PORT=8081

# Erlaubt http-Issuer bei der OIDC-Discovery (Phase 4a Task 3, Auth-Härtung
# M2) — separat von F451_INSECURE_COOKIES, damit ein unsicherer IdP NICHT
# automatisch mitfolgt, nur weil (z. B. lokal) Cookies ohne `secure` gesetzt
# werden. Ohne gesetzte Variable gilt der Wert von F451_INSECURE_COOKIES als
# Default (abwärtskompatibel). In Produktion NICHT setzen (Entra ID spricht
# ohnehin nur HTTPS).
#F451_OIDC_ALLOW_INSECURE=1

# Forgejo-Kontoverknüpfung ("Forgejo verbinden") — OAuth2-App auf derselben
# Instanz wie F451_FORGEJO_URL, Redirect-URI
# https://<api-host>/auth/connect/forgejo/callback.
F451_FORGEJO_OAUTH_CLIENT_ID=change-me-forgejo-oauth-client-id
F451_FORGEJO_OAUTH_CLIENT_SECRET=change-me-forgejo-oauth-client-secret

# GitHub-Kontoverknüpfung ("GitHub verbinden") — OAuth-App unter
# https://github.com/settings/developers, Authorization callback URL
# https://<api-host>/auth/connect/github/callback.
F451_GITHUB_OAUTH_CLIENT_ID=change-me-github-oauth-client-id
F451_GITHUB_OAUTH_CLIENT_SECRET=change-me-github-oauth-client-secret

# --- Draft-Backend (Phase 2a) -----------------------------------------------
# Optional, Default 10 — Größenlimit in MiB für den Media-Upload in Entwürfe
# (POST /api/pages/:id/draft/media). Details: apps/api/README.md, Abschnitt
# "Draft-API (Schreiben)".
#F451_MAX_UPLOAD_MB=10

# --- Rate-Limits (Phase 4a, Spec §7) ----------------------------------------
# Optional — Anfragebudget pro Minute (Zeitfenster ist fest 60s) für die
# Auth-Routen (Login/Callback/Logout/Provider-Verknüpfung) bzw. die Suche
# (GET /api/search). Ohne gesetzte Variablen gelten die Defaults 10 (Auth)
# bzw. 60 (Suche) Anfragen/Minute pro Client-IP. Das Limit gilt PRO Route:
# jede der 6 Auth-Routen hat einen EIGENEN Zähler (10/min auf jeder einzeln,
# kein gemeinsames Budget von 10 über alle Auth-Routen zusammen).
#F451_RATE_LIMIT_AUTH_MAX=10
#F451_RATE_LIMIT_SEARCH_MAX=60
# Alle Aufrufe mit API-Token (MCP-Agenten), pro Nutzer statt pro IP.
#F451_RATE_LIMIT_API_TOKEN_MAX=300

# Anzahl vertrauter Proxy-Hops vor der API. Dieses Compose-Deployment läuft
# IMMER hinter einem Reverse Proxy (Caddy/Traefik, Spec §8) — ohne diese
# Variable sähe die API für ALLE Nutzer dieselbe Proxy-IP und die Rate-Limits
# oben würden alle Nutzer in EINEM Zähler pro Route zusammenfassen (10 fremde
# Login-Versuche/Minute sperren den Login firmenweit). "1" = genau der letzte
# Hop (der eigene Proxy) ist vertraut; die Client-IP ist dann das vom Proxy
# selbst angehängte X-Forwarded-For-Glied, das der Client nicht fälschen
# kann. NICHT "true" setzen: damit zählte das LINKESTE X-Forwarded-For-Glied,
# das der Client selbst beliebig setzen kann — die Limits wären per Header-
# Spoofing trivial umgehbar. Nur in lokaler Entwicklung OHNE Proxy entfernen.
F451_TRUST_PROXY=1

# Öffentliche Basis-URL der f451-Oberfläche — die URL, unter der Nutzer das
# Wiki im Browser erreichen (der Reverse Proxy davor, Spec §8). Seit Phase 4a
# Task 3 SICHERHEITSRELEVANT, nicht mehr nur kosmetisch (PR-Body-Link):
#   1. Basis der OAuth-redirect_uri der Provider-Verknüpfung ("Forgejo/GitHub
#      verbinden") — ohne sie wird die redirect_uri aus dem (durch den Proxy
#      gereichten, prinzipiell manipulierbaren) Host-Header gebaut.
#   2. "Eigene Origin" des CSRF-Origin-Checks: mutierende Browser-Requests
#      (POST/PUT/PATCH/DELETE) mit einem Origin-Header, der NICHT zu dieser
#      URL passt, werden mit 403 abgelehnt — ohne sie vergleicht der Check
#      gegen den Host-Header des jeweiligen Requests (Proxy-Vertrauen).
# ACHTUNG bei Fehlkonfiguration: zeigt der Wert auf eine ANDERE Origin als
# die, unter der die Nutzer das Wiki tatsächlich aufrufen, blockiert der
# CSRF-Check ALLE mutierenden Browser-Requests (Speichern, Freigeben, …)
# mit 403 "Ungültige Origin". Exakt Schema + Host (+ Port) der echten
# Browser-URL eintragen, ohne Pfad.
F451_PUBLIC_BASE_URL=https://wiki.example.de
